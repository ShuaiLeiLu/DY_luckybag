# 自动检测文本文件并执行 LF 规范化
* text=auto

# 明确声明文本文件
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.vue text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf

# 明确声明二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary

# 敏感文件标记（防止意外提交）
tokens.json filter=secret
*.token filter=secret
*.session filter=secret
