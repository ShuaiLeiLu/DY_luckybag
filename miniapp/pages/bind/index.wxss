.bind-page {
  position: relative;
  padding-bottom: 24rpx;
}

.bind-header {
  padding: 26rpx 10rpx 18rpx;
}

.bind-title {
  font-size: 66rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #222d45;
}

.bind-status-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.bind-status-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #8fa0bb;
}

.bind-status-dot.success {
  background: #2bc267;
}

.bind-status-dot.pending {
  background: #6d7cff;
}

.bind-status-dot.danger {
  background: #ff6b6b;
}

.bind-status-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #7787a4;
}

.license-card {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 34rpx;
  border-radius: 42rpx;
  background: linear-gradient(145deg, #211a62 0%, #21155a 45%, #111a51 100%);
  box-shadow: 0 22rpx 60rpx rgba(24, 31, 89, 0.22);
}

.license-card__blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(26rpx);
  opacity: 0.95;
}

.license-card__blob--top {
  right: -50rpx;
  top: -28rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(93, 96, 255, 0.34);
}

.license-card__blob--bottom {
  left: -46rpx;
  bottom: -80rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(123, 70, 255, 0.16);
}

.license-card__glow {
  position: absolute;
  inset: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 42rpx;
}

.license-card__head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.license-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.1);
  color: #eef1ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
}

.license-meta {
  flex: 1;
}

.license-meta__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.license-name {
  flex: 1;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #ffffff;
}

.license-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #c9d2ff;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.08);
}

.license-chip.is-active {
  color: #2fed87;
  border-color: rgba(47, 237, 135, 0.28);
  background: rgba(13, 87, 58, 0.45);
}

.license-subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(225, 231, 255, 0.82);
}

.license-card__body {
  position: relative;
  z-index: 1;
  margin-top: 70rpx;
}

.license-label {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(229, 235, 255, 0.82);
}

.license-value-row {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.license-value {
  font-size: 120rpx;
  line-height: 1;
  font-weight: 800;
  color: #f5f6ff;
}

.license-unit {
  font-size: 52rpx;
  font-weight: 700;
  color: rgba(234, 238, 255, 0.85);
}

.license-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(220, 226, 255, 0.7);
}

.reward-card {
  position: relative;
  overflow: hidden;
  margin-top: 34rpx;
  padding: 30rpx 28rpx 30rpx;
  border-radius: 38rpx;
  background: linear-gradient(180deg, #fff9ef 0%, #fffdf7 100%);
  box-shadow: 0 14rpx 38rpx rgba(128, 94, 31, 0.08);
  border: 2rpx solid rgba(255, 194, 113, 0.14);
}

.reward-card__decor {
  position: absolute;
  right: -18rpx;
  top: -22rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(252, 196, 124, 0.13);
}

.reward-card__title-row {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.reward-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(255, 129, 22, 0.14);
  color: #ff7a00;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.reward-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #24314a;
}

.reward-subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #7f8da7;
}

.reward-button {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 28rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(180deg, #ffa400 0%, #ff8a00 100%);
  box-shadow: 0 20rpx 36rpx rgba(255, 141, 24, 0.25);
}

.reward-button[disabled] {
  opacity: 0.6;
}

.assist-button {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3d5d;
  background: #ffffff;
  border: 2rpx solid #e6ebf4;
}

.section-block {
  margin-top: 40rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 10rpx;
}

.section-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  background: #e8edfb;
  color: #7b88a4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #28344c;
}

.timeline-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.timeline-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(28, 54, 108, 0.06);
}

.timeline-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #edf0ff;
  color: #6a72ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
}

.timeline-content {
  flex: 1;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #29344b;
}

.timeline-time {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a97af;
}

.timeline-gain {
  font-size: 26rpx;
  font-weight: 800;
  color: #5a50ea;
}

.timeline-empty {
  margin-top: 22rpx;
  padding: 34rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  font-size: 28rpx;
  color: #8a97af;
  text-align: center;
}
