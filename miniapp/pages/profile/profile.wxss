.profile-page {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 172rpx;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 112rpx 40rpx 196rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #5b4df0 0%, #4f46e5 100%);
}

.profile-hero__blur {
  position: absolute;
  top: -56rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  filter: blur(24rpx);
}

.profile-hero__glow {
  position: absolute;
  bottom: -90rpx;
  left: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  filter: blur(36rpx);
}

.profile-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-shell {
  width: 132rpx;
  height: 132rpx;
  margin-right: 28rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.12);
}

.avatar-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8ebff;
}

.avatar-icon {
  width: 58rpx;
  height: 58rpx;
}

.profile-name {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.18;
}

.profile-level {
  display: block;
  margin-top: 12rpx;
  color: rgba(224, 231, 255, 0.92);
  font-size: 28rpx;
}

.summary-card {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: stretch;
  margin: -84rpx 32rpx 0;
  padding: 36rpx 8rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 42rpx rgba(15, 23, 42, 0.1);
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  display: block;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 600;
}

.summary-divider {
  width: 2rpx;
  margin: 8rpx 0;
  background: #e2e8f0;
}

.summary-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 18rpx;
}

.summary-value {
  color: #1e293b;
  font-size: 66rpx;
  line-height: 1;
  font-weight: 700;
}

.summary-unit {
  margin-left: 8rpx;
  color: #334155;
  font-size: 26rpx;
}

.menu-list {
  margin-top: 44rpx;
  padding: 0 32rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.035);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-bg {
  width: 78rpx;
  height: 78rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
}

.menu-icon {
  width: 34rpx;
  height: 34rpx;
}

.menu-label {
  color: #1e293b;
  font-size: 30rpx;
  font-weight: 600;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-value {
  margin-right: 12rpx;
  color: #94a3b8;
  font-size: 28rpx;
}

.menu-arrow {
  color: #cbd5e1;
  font-size: 42rpx;
  line-height: 1;
}
