<view class="profile-page">
  <view class="profile-hero">
    <view class="profile-hero__blur"></view>
    <view class="profile-hero__glow"></view>
    <view class="profile-main">
      <view class="avatar-shell">
        <view class="avatar-inner">
          <image class="avatar-icon" src="/assets/user-circle.svg" mode="aspectFit"></image>
        </view>
      </view>
      <view class="profile-texts">
        <text class="profile-name">{{ profileName }}</text>
        <text class="profile-level">{{ profileLevel }}</text>
      </view>
    </view>
  </view>

  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-label">累计获取时长</text>
      <view class="summary-value-row">
        <text class="summary-value">{{ remainValue }}</text>
        <text class="summary-unit">{{ remainUnit }}</text>
      </view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-label">绑定设备数</text>
      <view class="summary-value-row">
        <text class="summary-value">{{ deviceCount }}</text>
        <text class="summary-unit">台</text>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <block wx:for="{{ menuItems }}" wx:key="key">
      <view class="menu-card" data-key="{{ item.key }}" bindtap="handleMenuTap">
        <view class="menu-left">
          <view class="menu-icon-bg">
            <image class="menu-icon" src="{{ item.icon }}" mode="aspectFit"></image>
          </view>
          <text class="menu-label">{{ item.label }}</text>
        </view>
        <view class="menu-right">
          <text class="menu-value" wx:if="{{ item.value }}">{{ item.value }}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </block>
  </view>
</view>
