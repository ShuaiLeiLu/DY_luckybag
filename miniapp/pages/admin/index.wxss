.admin-page {
  min-height: 100vh;
  background: #f4f7fb;
  padding: 20rpx 28rpx 80rpx;
}

.admin-header {
  background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
  padding: 32rpx;
  border-radius: 26rpx;
  color: #fff;
  box-shadow: 0 24rpx 40rpx rgba(30, 41, 59, 0.24);
  margin-bottom: 22rpx;
}

.admin-title { font-size: 38rpx; font-weight: 800; letter-spacing: 1rpx; }
.admin-subtitle { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.72); }

.admin-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.admin-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.12);
  color: #dbe4ff;
  font-weight: 700;
  font-size: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.18);
}

.admin-tab.is-active {
  background: #ffffff;
  color: #1e293b;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 10rpx 20rpx rgba(15, 23, 42, 0.06);
}

.stat-label { font-size: 22rpx; color: #64748b; }
.stat-value { font-size: 34rpx; font-weight: 800; margin-top: 10rpx; color: #0f172a; }
.stat-note { font-size: 20rpx; color: #94a3b8; margin-top: 6rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 10rpx 20rpx rgba(15, 23, 42, 0.05);
  margin-bottom: 20rpx;
}

.card-hd {
  padding: 18rpx 20rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #eef2f7;
  color: #475569;
  font-size: 24rpx;
}

.card-bd { padding: 20rpx; }

.pill-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.pill {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.pill.ok { background: #dcfce7; color: #166534; }
.pill.off { background: #fee2e2; color: #991b1b; }
.pill.info { background: #e0f2fe; color: #0369a1; }

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.service-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 12rpx;
}

.service-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #94a3b8;
  box-shadow: 0 0 12rpx rgba(148, 163, 184, 0.6);
}

.service-dot.ok {
  background: #22c55e;
  box-shadow: 0 0 12rpx rgba(34, 197, 94, 0.6);
}

.service-dot.off {
  background: #ef4444;
  box-shadow: 0 0 12rpx rgba(239, 68, 68, 0.6);
}

.service-dot.info {
  background: #38bdf8;
  box-shadow: 0 0 12rpx rgba(56, 189, 248, 0.6);
}

.service-name {
  font-size: 20rpx;
  color: #64748b;
}

.service-status {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
  margin-top: 4rpx;
}

.config-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.config-title { font-size: 26rpx; font-weight: 700; color: #0f172a; }
.config-desc { font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }
.config-row--spaced { margin-top: 18rpx; }
.config-row--block { flex-direction: column; align-items: flex-start; gap: 12rpx; }

.form-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.input {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  padding: 0 18rpx;
  font-size: 24rpx;
  background: #f8fafc;
}
.input--sm { width: 180rpx; flex: none; }
.btn {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #4f46e5;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.textarea {
  min-height: 140rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  padding: 18rpx;
  font-size: 22rpx;
  background: #f8fafc;
}

.search-row { margin-bottom: 18rpx; }
.search-input {
  width: 100%;
  height: 72rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  padding: 0 18rpx;
  font-size: 24rpx;
  background: #fff;
}

.section-title { font-size: 24rpx; font-weight: 700; color: #334155; margin: 10rpx 0 12rpx; }

.device-list { display: flex; flex-direction: column; gap: 12rpx; }
.device-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #e5e7eb;
  padding: 18rpx;
}
.device-title { display: flex; align-items: center; gap: 10rpx; }
.device-id { font-size: 22rpx; font-weight: 700; color: #0f172a; }
.device-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.device-dot.ok { background: #22c55e; }
.device-dot.off { background: #ef4444; }
.device-meta { font-size: 20rpx; color: #64748b; margin-top: 6rpx; }

.btn-secondary {
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: #475569;
}

.table-row {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  border-bottom: 1rpx solid #eef2f7;
}
.table-head { background: #f8fafc; font-weight: 700; color: #64748b; }
.col-time { text-align: right; color: #94a3b8; }
.col-action.signin { color: #4f46e5; font-weight: 700; }
.col-action.bind { color: #22c55e; font-weight: 700; }
.col-action.verify { color: #f59e0b; font-weight: 700; }

.log-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.log-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 18rpx;
  border: 1rpx solid #e5e7eb;
  padding: 16rpx 18rpx;
}

.log-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}

.log-target {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #64748b;
}

.log-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.log-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: #f1f5f9;
  color: #475569;
}

.log-tag.signin { background: #eef2ff; color: #4f46e5; }
.log-tag.bind { background: #dcfce7; color: #166534; }
.log-tag.verify { background: #fff7ed; color: #c2410c; }

.log-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.panel { animation: fadeIn 0.2s ease-out; }

.risk-card .card-bd { display: flex; flex-direction: column; gap: 12rpx; }
.risk-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #fef2f2;
  border: 1rpx solid #fee2e2;
  color: #991b1b;
  font-size: 22rpx;
}
.risk-label { font-weight: 600; }
.risk-count { font-weight: 800; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}
