.privacy-page {
  min-height: 100vh;
  background: #f8fafc;
  padding: 36rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.privacy-header {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.privacy-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}

.privacy-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.privacy-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.08);
}

.privacy-section + .privacy-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.privacy-section__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 10rpx;
}

.privacy-section__text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}
