{
  "name": "dy-fudai-desktop",
  "version": "3.0.0",
  "description": "Windows 桌面端服务端派单福袋工作台",
  "author": "lushuailei",
  "main": "electron/main-browserview.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:license": "cd pool-server-go && go test ./internal/license",
    "pool:server:go": "cd pool-server-go && sh -c 'if command -v go >/dev/null 2>&1; then exec go run ./cmd/poolserver; elif [ -x \"$HOME/.local/go/bin/go\" ]; then exec \"$HOME/.local/go/bin/go\" run ./cmd/poolserver; else echo \"go not found: install Go or add ~/.local/go/bin to PATH\"; exit 127; fi'",
    "pool:learning:replay": "cd pool-server-go && sh -c 'if command -v go >/dev/null 2>&1; then exec go run ./cmd/learning-replay; elif [ -x \"$HOME/.local/go/bin/go\" ]; then exec \"$HOME/.local/go/bin/go\" run ./cmd/learning-replay; else echo \"go not found: install Go or add ~/.local/go/bin to PATH\"; exit 127; fi'",
    "pool:docker:build": "bash ./scripts/build-pool-image.sh",
    "pool:docker:up": "bash ./scripts/deploy-pool-local.sh",
    "pool:db:init": "node ./scripts/init-license-db.mjs",
    "pool:db:init:dry": "node ./scripts/init-license-db.mjs --dry-run",
    "pool:dump": "node ./scripts/pool-dump.mjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.dy.fudai.desktop",
    "productName": "抖娃福袋工作台",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main-browserview.js"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/dy-fudai/windows"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  }
}
