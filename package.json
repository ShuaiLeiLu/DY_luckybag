{
  "name": "douyin-lottery-assistant",
  "version": "1.0.0",
  "description": "抖音福袋自动参与助手",
  "main": "electron/main-browserview.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pool:server:go": "cd pool-server-go && sh -c 'if command -v go >/dev/null 2>&1; then exec go run ./cmd/poolserver; elif [ -x \"$HOME/.local/go/bin/go\" ]; then exec \"$HOME/.local/go/bin/go\" run ./cmd/poolserver; else echo \"go not found: install Go or add ~/.local/go/bin to PATH\"; exit 127; fi'",
    "pool:docker:build": "bash ./scripts/build-pool-image.sh",
    "pool:docker:up": "bash ./scripts/deploy-pool-local.sh",
    "pool:dump": "node ./scripts/pool-dump.mjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.6.0",
    "naive-ui": "^2.38.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.douyin.lottery.assistant",
    "productName": "抖音福袋助手",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "抖音福袋助手"
    }
  }
}
