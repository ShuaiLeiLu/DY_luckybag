{
  "name": "dy-fudai-desktop",
  "version": "3.0.1",
  "description": "Windows 桌面端服务端派单福袋工作台",
  "author": "lushuailei",
  "private": true,
  "main": "apps/desktop/electron/main-browserview.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "desktop:dev": "vite --config apps/desktop/vite.config.mjs",
    "desktop:build": "tsc --noEmit -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.mjs",
    "desktop:hot:manifest": "node ./scripts/build-desktop-hot-manifest.mjs",
    "desktop:test": "vitest run --config apps/desktop/vite.config.mjs",
    "server:test:license": "cd apps/pool-server && go test ./internal/license",
    "server:run": "node ./run-go.mjs --cwd apps/pool-server run ./cmd/poolserver",
    "server:learning:replay": "node ./run-go.mjs --cwd apps/pool-server run ./cmd/learning-replay",
    "server:docker:build": "bash ./scripts/build-pool-image.sh",
    "server:docker:up": "bash ./scripts/deploy-pool-local.sh",
    "server:db:init": "node ./scripts/init-license-db.mjs",
    "server:db:init:dry": "node ./scripts/init-license-db.mjs --dry-run",
    "server:dump": "node ./scripts/pool-dump.mjs",
    "desktop:electron:dev": "concurrently \"npm run desktop:dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "desktop:electron:build:win": "npm run desktop:build && electron-builder --win nsis --x64 --publish never",
    "release:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/release-publish.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.dy.fudai.desktop",
    "productName": "抖娃福袋工作台",
    "asar": true,
    "directories": {
      "output": "apps/desktop/dist-electron"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "apps/desktop/electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "apps/desktop/electron/main-browserview.js"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/dy-fudai/windows"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "apps/desktop/build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  }
}
