/* pages/index/index.wxss */
.container {
  padding: 40rpx;
  position: relative;
  z-index: 1;
}

/* Ambient Lighting Background */
.ambient-light {
  position: fixed;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  filter: blur(100px);
  z-index: -1;
  opacity: 0.5;
}

.blue-light {
  top: -200rpx;
  left: -200rpx;
  background: var(--primary-glow);
}

.purple-light {
  bottom: 200rpx;
  right: -200rpx;
  background: rgba(139, 92, 246, 0.2);
}

/* 1. Header Section */
.header-section {
  padding: 40rpx;
  margin-bottom: 40rpx;
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(15, 23, 42, 0.4) 100%);
}

.header-top {
  margin-bottom: 40rpx;
}

.icon-box {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-icon {
  width: 48rpx;
  height: 48rpx;
}

.status-indicator {
  gap: 16rpx;
  margin-top: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  animation: pulseGlow 2s infinite;
}

.status-success .dot { background-color: var(--success-color); box-shadow: 0 0 12rpx var(--success-glow); }
.status-danger .dot { background-color: var(--danger-color); box-shadow: 0 0 12rpx rgba(239, 68, 68, 0.3); animation: none;}

/* Gauge */
.gauge-container {
  position: relative;
  padding: 40rpx 0;
}

.gauge-value {
  font-size: 120rpx;
  line-height: 1;
  background: linear-gradient(to right, #fff, #94a3b8);
  -webkit-background-clip: text;
  color: transparent;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
}

.gauge-sub {
  gap: 8rpx;
  margin-top: -10rpx;
  color: var(--text-sub);
}

.separator {
  color: var(--text-muted);
  margin: 0 4rpx;
}

.gauge-label {
  margin-top: 24rpx;
}

/* 2. Device Section */
.device-section {
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.border-b {
  border-bottom: 1px solid var(--surface-border);
}

.pb-sm { padding-bottom: 24rpx; }
.pt-md { padding-top: 32rpx; }
.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 40rpx; }
.mt-sm { margin-top: 16rpx; }

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.info-row:last-child { margin-bottom: 0; }

.text-success { color: var(--success-color); }

/* Empty State / Scan Button */
.py-xl { padding: 64rpx 0; }

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.btn-scan {
  background: var(--primary-color);
  color: #fff;
  border-radius: 100rpx;
  padding: 24rpx 64rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 32rpx var(--primary-glow);
  transition: all 0.3s ease;
}

.btn-scan:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx var(--primary-glow);
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 3. Action Section (Rewards) */
.reward-card {
  padding: 48rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.reward-glow {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 200rpx;
  background: var(--primary-glow);
  filter: blur(60px);
  z-index: 0;
}

.btn-primary {
  width: 100%;
  background: linear-gradient(135deg, var(--primary-color) 0%, #2563eb 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 40rpx var(--primary-glow);
  border: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;
  z-index: 1;
}

.btn-primary::after { border: none; } /* Remove default WeChat button border */

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.btn-disabled {
  background: var(--surface-color);
  color: var(--text-sub);
  box-shadow: none;
  border: 1px solid var(--surface-border);
}

/* Notice Section */
.notice-section {
  padding: 32rpx;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.2);
}

.notice-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  color: var(--warning-color);
  line-height: 1.5;
}

.bottom-padding {
  height: 160rpx; /* Space for custom tab bar */
}
