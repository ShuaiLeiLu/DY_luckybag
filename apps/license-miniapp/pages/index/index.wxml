<!-- pages/index/index.wxml -->
<view class="container">
  
  <!-- Background Ambience -->
  <view class="ambient-light blue-light"></view>
  <view class="ambient-light purple-light"></view>

  <!-- 1. Header & Status Section -->
  <view class="header-section glass-panel animate-float">
    <view class="flex-row justify-between items-center header-top">
      <view class="flex-col">
        <text class="label-caps">当前状态</text>
        <view class="flex-row items-center status-indicator {{isLicenseExpired ? 'status-danger' : 'status-success'}}">
          <view class="dot"></view>
          <text class="text-h2">{{sessionStatusText}}</text>
        </view>
      </view>
      <view class="icon-box">
        <image src="../../assets/shield-check.svg" mode="aspectFit" class="header-icon" wx:if="{{!isLicenseExpired}}"></image>
        <image src="../../assets/shield-check.svg" mode="aspectFit" class="header-icon" style="filter: grayscale(100%); opacity: 0.5;" wx:else></image>
      </view>
    </view>

    <!-- Time Remaining Gauge -->
    <view class="gauge-container flex-col items-center justify-center">
      <text class="gauge-value text-hero">{{remainingParts.days || 0}}</text>
      <view class="flex-row items-center gauge-sub">
        <text class="text-h2">{{remainingParts.hours || 0}}h</text>
        <text class="text-h2 separator">:</text>
        <text class="text-h2">{{remainingParts.minutes || 0}}m</text>
      </view>
      <text class="label-caps gauge-label">剩余授权时间</text>
    </view>
  </view>

  <!-- 2. Device Card -->
  <view class="device-section glass-panel">
    <view class="flex-row justify-between items-center border-b pb-sm">
      <text class="label-caps">已绑定设备</text>
      <text class="text-sub text-mono">{{sessionInfo.clientId || '未绑定'}}</text>
    </view>
    
    <block wx:if="{{sessionInfo.clientId}}">
      <view class="flex-col pt-md">
        <view class="info-row">
          <text class="text-sub">授权模式</text>
          <text class="text-body font-semibold">{{sessionInfo.accessMode === 'unrestricted' ? '服务端免授权' : (sessionInfo.accessMode === 'licensed' ? '专业版' : '试用版')}}</text>
        </view>
        <view class="info-row">
          <text class="text-sub">网络状态</text>
          <text class="text-body text-success">在线</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-state flex-col items-center justify-center py-xl">
        <image src="../../assets/smartphone.svg" mode="aspectFit" class="empty-icon"></image>
        <text class="text-body mb-md text-center">暂未绑定桌面端。请使用微信扫描桌面客户端上的二维码进行绑定。</text>
        <button class="btn-scan" bindtap="handleScanCode">
          扫码绑定设备
        </button>
      </view>
    </block>
  </view>

  <!-- 3. Primary Action (Rewards) -->
  <view class="action-section" wx:if="{{showSigninAdButton}}">
    <view class="reward-card glass-panel flex-col items-center">
      <view class="reward-glow"></view>
      <text class="text-h2 mb-sm text-center">延长使用时间</text>
      <text class="text-sub text-center mb-lg">{{rewardCopy.subtitleText}}</text>
      
      <button 
        class="btn-primary {{btnDisabled ? 'btn-disabled' : ''}}" 
        bindtap="handleSigninTap" 
        loading="{{btnLoading}}"
        disabled="{{btnDisabled}}"
      >
        <view class="btn-content">
          <text>{{rewardCopy.buttonText}}</text>
        </view>
      </button>
      
      <text class="text-sub text-center mt-sm" wx:if="{{todayAlreadySigned}}">您今天已经领取过奖励了，请明天再来！</text>
    </view>
  </view>

  <!-- Notice/Message Area -->
  <view class="notice-section glass-panel" wx:if="{{hasBackendMessage}}">
    <view class="flex-row items-start">
      <text class="text-sub notice-text">{{sessionInfo.message}}</text>
    </view>
  </view>

  <view class="bottom-padding"></view>
</view>
