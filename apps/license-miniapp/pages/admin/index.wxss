.admin-page {
  min-height: 100vh;
  padding: 20rpx 28rpx 88rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(79, 70, 229, 0.12), transparent 28%),
    radial-gradient(circle at top right, rgba(14, 165, 233, 0.12), transparent 24%),
    linear-gradient(180deg, #f7f9fc 0%, #eef3fb 100%);
}

.admin-hero {
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 55%, #111827 100%);
  color: #fff;
  box-shadow: 0 24rpx 46rpx rgba(15, 23, 42, 0.18);
  margin-bottom: 20rpx;
  overflow: hidden;
  position: relative;
}

.admin-hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(129, 140, 248, 0.3) 0%, rgba(15, 23, 42, 0) 72%);
  pointer-events: none;
}

.hero-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.admin-title {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.admin-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-badge,
.mini-badge,
.license-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 700;
  white-space: nowrap;
}

.hero-badge {
  padding: 12rpx 22rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.12);
}

.hero-badge.is-ok {
  color: #a7f3d0;
}

.hero-badge.is-off {
  color: #fecaca;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.hero-metric {
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.metric-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.68);
}

.metric-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.hero-foot {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  position: relative;
  z-index: 1;
}

.admin-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.admin-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid #dbe4ef;
  color: #475569;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 18rpx rgba(15, 23, 42, 0.04);
}

.admin-tab.is-active {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #fff;
  border-color: transparent;
}

.admin-body {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.alert {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
  background: #fff7ed;
  border-color: #fed7aa;
  color: #9a3412;
}

.alert-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
}

.alert-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.card {
  background: #fff;
  border-radius: 22rpx;
  border: 1rpx solid #e5eaf3;
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
}

.card-hd {
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  border-bottom: 1rpx solid #eef2f7;
  background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
}

.card-bd {
  padding: 20rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.status-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #94a3b8;
  box-shadow: 0 0 12rpx rgba(148, 163, 184, 0.45);
}

.status-dot.ok {
  background: #22c55e;
  box-shadow: 0 0 12rpx rgba(34, 197, 94, 0.45);
}

.status-dot.off {
  background: #ef4444;
  box-shadow: 0 0 12rpx rgba(239, 68, 68, 0.45);
}

.status-dot.info {
  background: #38bdf8;
  box-shadow: 0 0 12rpx rgba(56, 189, 248, 0.45);
}

.status-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
}

.status-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #64748b;
}

.filter-summary {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.filter-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 20rpx;
  font-weight: 700;
}

.token-row,
.search-actions,
.pager {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.token-row {
  flex-wrap: wrap;
}

.token-input,
.search-input,
.input,
.textarea {
  border: 1rpx solid #dbe2ee;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.token-input,
.search-input {
  flex: 1;
  min-width: 300rpx;
  height: 76rpx;
  padding: 0 20rpx;
}

.hint {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
}

.switch-row--soft {
  margin-top: 14rpx;
}

.field-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.field-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.mini-badge {
  padding: 10rpx 18rpx;
  font-size: 20rpx;
  background: #e2e8f0;
  color: #334155;
}

.mini-badge.is-ok {
  background: #dcfce7;
  color: #166534;
}

.mini-badge.is-off {
  background: #fee2e2;
  color: #991b1b;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 700;
}

.input {
  height: 76rpx;
  padding: 0 18rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  resize: none;
}

.btn {
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.btn--ghost {
  background: #f1f5f9;
  color: #334155;
  border: 1rpx solid #dbe2ee;
}

.btn--block {
  width: 100%;
}

.search-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.search-actions {
  flex-wrap: wrap;
}

.picker-trigger {
  min-width: 180rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe2ee;
  color: #334155;
  font-size: 22rpx;
  font-weight: 700;
}

.license-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-state {
  padding: 48rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx dashed #dbe2ee;
  color: #94a3b8;
  text-align: center;
  font-size: 24rpx;
}

.license-card {
  background: #fff;
  border-radius: 22rpx;
  border: 1rpx solid #e5eaf3;
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.05);
  padding: 20rpx;
}

.license-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.license-main {
  min-width: 0;
}

.license-key {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
  word-break: break-all;
}

.license-owner {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.license-chip {
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  background: #eef2ff;
  color: #4338ca;
}

.license-chip.ok {
  background: #dcfce7;
  color: #166534;
}

.license-chip.off {
  background: #fee2e2;
  color: #991b1b;
}

.license-chip.info {
  background: #e0f2fe;
  color: #075985;
}

.license-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.license-field {
  padding: 14rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
}

.license-label {
  font-size: 20rpx;
  color: #64748b;
}

.license-value {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #0f172a;
  line-height: 1.5;
  word-break: break-all;
}

.license-meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.license-actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mini-btn {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
}

.mini-btn--warn {
  background: #fff7ed;
  color: #c2410c;
}

.mini-btn--danger {
  background: #fee2e2;
  color: #b91c1c;
}

.pager {
  justify-content: space-between;
  padding: 8rpx 2rpx 0;
}

.pager-text {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 700;
}

.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

@media (max-width: 760px) {
  .hero-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .status-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .license-grid {
    grid-template-columns: 1fr;
  }

  .pager {
    flex-direction: column;
    align-items: stretch;
  }

  .token-input,
  .search-input {
    min-width: 0;
    width: 100%;
  }

  .search-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .picker-trigger {
    width: 100%;
  }
}
