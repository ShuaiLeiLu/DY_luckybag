<view class="admin-page" style="padding-top: {{ topInset }}px;">
  <view class="admin-hero">
    <view class="hero-topline">
      <view>
        <view class="admin-title">抖娃控制台</view>
        <view class="admin-subtitle">小程序端管理台 · 仅前端接入</view>
      </view>
      <view class="hero-badge {{ serviceStatus.license ? 'is-ok' : 'is-off' }}">
        {{ serviceStatus.license ? '服务在线' : '服务异常' }}
      </view>
    </view>

    <view class="hero-metrics">
      <view class="hero-metric">
        <view class="metric-label">已加载授权</view>
        <view class="metric-value">{{ metrics.total }}</view>
      </view>
      <view class="hero-metric">
        <view class="metric-label">启用中</view>
        <view class="metric-value">{{ metrics.active }}</view>
      </view>
      <view class="hero-metric">
        <view class="metric-label">已绑定设备</view>
        <view class="metric-value">{{ metrics.bound }}</view>
      </view>
      <view class="hero-metric">
        <view class="metric-label">已绑定微信</view>
        <view class="metric-value">{{ metrics.wechat }}</view>
      </view>
    </view>

    <view class="hero-foot">
      <text>{{ summaryText }}</text>
      <text>{{ lastUpdatedText }}</text>
    </view>
  </view>

  <view class="admin-tabs">
    <view class="admin-tab {{ adminTab === 'overview' ? 'is-active' : '' }}" data-tab="overview" bindtap="switchTab">系统概览</view>
    <view class="admin-tab {{ adminTab === 'config' ? 'is-active' : '' }}" data-tab="config" bindtap="switchTab">系统配置</view>
    <view class="admin-tab {{ adminTab === 'licenses' ? 'is-active' : '' }}" data-tab="licenses" bindtap="switchTab">授权池列表</view>
  </view>

  <view class="admin-body">
    <view wx:if="{{ errorText }}" class="alert alert--warn">
      <text class="alert-title">当前状态</text>
      <text class="alert-text">{{ errorText }}</text>
    </view>

    <view wx:if="{{ adminTab === 'overview' }}" class="panel">
      <view class="card">
        <view class="card-hd">系统状态</view>
        <view class="card-bd">
          <view class="status-grid">
            <view class="status-chip">
              <view class="status-dot {{ serviceStatus.license ? 'ok' : 'off' }}"></view>
              <view>
                <view class="status-name">授权服务</view>
                <view class="status-desc">{{ serviceStatus.license ? '正常响应' : '不可用或未授权' }}</view>
              </view>
            </view>
            <view class="status-chip">
              <view class="status-dot {{ serviceStatus.unrestricted ? 'ok' : 'off' }}"></view>
              <view>
                <view class="status-name">免授权模式</view>
                <view class="status-desc">{{ serviceStatus.unrestricted ? '已开启' : '已关闭' }}</view>
              </view>
            </view>
            <view class="status-chip">
              <view class="status-dot info"></view>
              <view>
                <view class="status-name">数据源</view>
                <view class="status-desc">同域基础地址</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-hd">当前筛选</view>
        <view class="card-bd">
          <view class="filter-summary">
            <view class="filter-pill">关键词：{{ query.keyword || '全部' }}</view>
            <view class="filter-pill">状态：{{ statusLabel }}</view>
            <view class="filter-pill">页码：{{ page }}/{{ totalPages }}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{ adminTab === 'config' }}" class="panel">
      <view class="card">
        <view class="card-hd">管理员令牌</view>
        <view class="card-bd">
          <view class="token-row">
            <input class="token-input" type="text" value="{{ adminToken }}" placeholder="请输入管理员令牌" bindinput="onTokenInput" bindblur="onTokenBlur" />
            <button class="btn btn--ghost" bindtap="clearToken">清空</button>
            <button class="btn" bindtap="saveToken" loading="{{ savingToken }}">保存</button>
          </view>
          <view class="hint">每次请求都会自动携带管理员令牌。</view>
        </view>
      </view>

      <view class="card">
        <view class="card-hd">授权系统配置</view>
        <view class="card-bd">
          <view class="switch-row">
            <view>
              <view class="field-title">授权免限制开关</view>
              <view class="field-desc">开启后所有客户端跳过授权校验</view>
            </view>
            <switch checked="{{ serviceStatus.unrestricted }}" bindchange="toggleUnrestricted" color="#4f46e5"></switch>
          </view>
          <view class="switch-row switch-row--soft">
            <view>
              <view class="field-title">服务状态</view>
              <view class="field-desc">{{ serviceStatus.license ? '接口可用' : '请检查后台管理员令牌或服务状态' }}</view>
            </view>
            <view class="mini-badge {{ serviceStatus.license ? 'is-ok' : 'is-off' }}">
              {{ serviceStatus.loading ? '处理中' : (serviceStatus.license ? '在线' : '离线') }}
            </view>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-hd">批量创建授权</view>
        <view class="card-bd">
          <view class="form-row">
            <view class="form-field">
              <view class="field-label">授权天数</view>
              <input class="input" type="number" value="{{ createDays }}" placeholder="30" bindinput="onCreateDaysInput" />
            </view>
            <view class="form-field">
              <view class="field-label">授权数量</view>
              <input class="input" type="number" value="{{ createQuantity }}" placeholder="1" bindinput="onCreateQuantityInput" />
            </view>
          </view>
          <button class="btn btn--block" bindtap="createLicenses" loading="{{ submitting }}">创建授权码</button>
          <textarea class="textarea" value="{{ createdKeys }}" placeholder="创建成功后，生成的授权码会显示在这里" disabled></textarea>
        </view>
      </view>
    </view>

    <view wx:elif="{{ adminTab === 'licenses' }}" class="panel">
      <view class="card">
        <view class="card-hd">筛选与刷新</view>
        <view class="card-bd">
          <view class="search-stack">
            <input class="search-input" value="{{ query.keyword }}" placeholder="搜索授权码 / 客户名 / 微信用户标识 / 设备编号" bindinput="onKeywordInput" bindconfirm="onKeywordConfirm" confirm-type="search" />
            <view class="search-actions">
              <picker mode="selector" range="{{ statusOptions }}" range-key="label" bindchange="onStatusPick">
                <view class="picker-trigger">状态：{{ statusLabel }}</view>
              </picker>
              <button class="btn btn--ghost" bindtap="clearFilter">重置</button>
              <button class="btn" bindtap="applyFilter" loading="{{ loadingLicenses }}">搜索</button>
              <button class="btn btn--ghost" bindtap="refreshAll" loading="{{ refreshing }}">刷新</button>
            </view>
          </view>
          <view class="hint">当前页：{{ page }}/{{ totalPages }} · 共 {{ total }} 条</view>
        </view>
      </view>

      <view class="license-list">
        <view wx:if="{{ loadingLicenses && !licenses.length }}" class="empty-state">
          正在加载授权池...
        </view>

        <view wx:for="{{ licenses }}" wx:key="id" class="license-card">
          <view class="license-top">
            <view class="license-main">
              <view class="license-key">{{ item.licenseKey || '未命名授权' }}</view>
              <view class="license-owner">{{ item.customerName }} · {{ item.planName }}</view>
            </view>
            <view class="license-chip {{ item.statusTone }}">{{ item.statusLabel }}</view>
          </view>

          <view class="license-grid">
            <view class="license-field">
              <view class="license-label">到期时间</view>
              <view class="license-value">{{ item.expireAtText }}</view>
            </view>
            <view class="license-field">
              <view class="license-label">绑定客户端</view>
              <view class="license-value mono">{{ item.bindClientIdText }}</view>
            </view>
            <view class="license-field">
              <view class="license-label">微信昵称</view>
              <view class="license-value">{{ item.wechatNicknameText }}</view>
            </view>
            <view class="license-field">
              <view class="license-label">微信用户标识</view>
              <view class="license-value mono">{{ item.wechatOpenIdText }}</view>
            </view>
            <view class="license-field">
              <view class="license-label">最近活跃</view>
              <view class="license-value">{{ item.lastSeenAtText }}</view>
            </view>
            <view class="license-field">
              <view class="license-label">特征数量</view>
              <view class="license-value">{{ item.featureCount }}</view>
            </view>
          </view>

          <view class="license-meta">
            <text>绑定指纹：{{ item.bindFingerprintText }}</text>
            <text>创建时间：{{ item.createdAtText }}</text>
            <text>更新时间：{{ item.updatedAtText }}</text>
            <text>激活次数：{{ item.activationCount }}</text>
          </view>

          <view class="license-actions">
            <button class="mini-btn" data-action="enable" data-id="{{ item.id }}" bindtap="openActionMenu" wx:if="{{ item.status !== 'active' }}" loading="{{ busyActionKey === item.enableActionKey }}">启用</button>
            <button class="mini-btn mini-btn--warn" data-action="disable" data-id="{{ item.id }}" bindtap="openActionMenu" wx:if="{{ item.status === 'active' }}" loading="{{ busyActionKey === item.disableActionKey }}">停用</button>
            <button class="mini-btn" data-action="extend" data-id="{{ item.id }}" bindtap="openActionMenu" loading="{{ busyActionKey === item.extendActionKey }}">续期30天</button>
            <button class="mini-btn" data-action="unbind" data-id="{{ item.id }}" bindtap="openActionMenu" loading="{{ busyActionKey === item.unbindActionKey }}">解绑</button>
            <button class="mini-btn mini-btn--danger" data-action="delete" data-id="{{ item.id }}" bindtap="openActionMenu" loading="{{ busyActionKey === item.deleteActionKey }}">删除</button>
          </view>
        </view>
      </view>

      <view class="pager">
        <button class="btn btn--ghost" bindtap="prevPage" disabled="{{ page <= 1 }}">上一页</button>
        <view class="pager-text">第 {{ page }} / {{ totalPages }} 页</view>
        <button class="btn btn--ghost" bindtap="nextPage" disabled="{{ page >= totalPages }}">下一页</button>
      </view>
    </view>
  </view>
</view>
