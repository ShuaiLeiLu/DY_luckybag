.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #ffffff;
  padding-bottom: calc(env(safe-area-inset-bottom) + 6rpx);
}

.tabbar-border {
  height: 1rpx;
  background: rgba(148, 163, 184, 0.22);
  transform: scaleY(0.5);
  transform-origin: top;
}

.tabbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 116rpx;
  padding: 8rpx 24rpx 0;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
}

.tab-item--active {
  color: #4f46e5;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}

.tab-label {
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}
