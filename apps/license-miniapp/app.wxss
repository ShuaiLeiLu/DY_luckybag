/** app.wxss **/
page {
  /* Tech-Glass Color Palette */
  --bg-color: #020617;
  --surface-color: rgba(15, 23, 42, 0.6);
  --surface-border: rgba(255, 255, 255, 0.05);
  
  --primary-color: #3b82f6;
  --primary-glow: rgba(59, 130, 246, 0.3);
  
  --success-color: #10b981;
  --success-glow: rgba(16, 185, 129, 0.3);
  
  --warning-color: #f59e0b;
  --danger-color: #ef4444;

  --text-main: #f8fafc;
  --text-sub: #94a3b8;
  --text-muted: #475569;

  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Global Glass Panel Utility */
.glass-panel {
  background: var(--surface-color);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--surface-border);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

/* Base Flex Utilities */
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }

/* Typography */
.text-hero { font-size: 64rpx; font-weight: 800; letter-spacing: -1rpx; }
.text-h1 { font-size: 40rpx; font-weight: 700; }
.text-h2 { font-size: 32rpx; font-weight: 600; }
.text-body { font-size: 28rpx; color: var(--text-main); }
.text-sub { font-size: 24rpx; color: var(--text-sub); }
.text-mono { font-family: 'Courier New', Courier, monospace; }

.label-caps {
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  font-weight: 700;
  color: var(--text-muted);
}

/* Animations */
@keyframes pulseGlow {
  0% { box-shadow: 0 0 0 0 var(--primary-glow); }
  70% { box-shadow: 0 0 0 20rpx rgba(59, 130, 246, 0); }
  100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
}

@keyframes float {
  0% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
  100% { transform: translateY(0); }
}

.animate-float { animation: float 6s ease-in-out infinite; }
